{
  "name": "rent-rush",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "node -e \"require('fs').copyFileSync('amplify_outputs.production.json','amplify_outputs.json')\" && next build",
    "start": "npx serve out",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p amplify/tsconfig.json",
    "sandbox": "ampx sandbox --profile aws-project",
    "sandbox:once": "ampx sandbox --once --profile aws-project",
    "sandbox:delete": "ampx sandbox delete --profile aws-project",
    "art:templates": "tsx scripts/print-art-spec.ts | python scripts/make-art-templates.py",
    "art:slice": "tsx scripts/print-art-spec.ts | python scripts/slice-board.py",
    "art:tokens": "python scripts/slice-tokens.py",
    "deploy": "node scripts/deploy.mjs",
    "cards:export": "tsx scripts/export-cards.ts",
    "art:deeds": "tsx scripts/print-deed-spec.ts | python scripts/import-deeds.py",
    "deploy:backend": "node scripts/deploy.mjs --backend-only"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.7",
    "aws-amplify": "^6.22.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1171.0",
    "@aws-sdk/client-dynamodb": "^3.1171.0",
    "@aws-sdk/lib-dynamodb": "^3.1171.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.171.0",
    "aws-cdk": "^2.1148.1",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "config": {
    "amplifyAppId": "d87bfel7lqeu0",
    "awsProfile": "aws-project",
    "awsRegion": "us-east-2"
  }
}
